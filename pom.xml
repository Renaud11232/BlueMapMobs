<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>be.renaud11232</groupId>
    <artifactId>bluemap-entities</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>BlueMap plugin that adds mobs (and vehicles) on the map, much like dynmap-mobs for dynmap</description>
    <url>https://github.com/Renaud11232/BlueMapMobs</url>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <org.apache.maven.plugins.maven-compiler-plugin.version>3.15.0</org.apache.maven.plugins.maven-compiler-plugin.version>
        <org.apache.maven.plugins.maven-shade-plugin.version>3.6.2</org.apache.maven.plugins.maven-shade-plugin.version>
        <net.minecraft.target.version>26.1</net.minecraft.target.version>
        <net.minecraft.build.version>[26.1, 26.2)</net.minecraft.build.version>
        <org.spigotmc.spigot-api.version>${net.minecraft.build.version}</org.spigotmc.spigot-api.version>
        <io.papermc.paper.paper-api.version>${net.minecraft.build.version}</io.papermc.paper.paper-api.version>
        <de.bluecolored.bluemap-api.version>2.7.8</de.bluecolored.bluemap-api.version>
        <net.citizensnpcs.citizens-main.version>2.0.42-SNAPSHOT</net.citizensnpcs.citizens-main.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${org.apache.maven.plugins.maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${org.apache.maven.plugins.maven-shade-plugin.version}</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>shade</goal>
                            </goals>
                            <configuration>
                                <createDependencyReducedPom>false</createDependencyReducedPom>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/groups/public/</url>
        </repository>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>bluecolored-repo</id>
            <url>https://repo.bluecolored.de/releases</url>
        </repository>
        <repository>
            <id>citizens-repo</id>
            <url>https://maven.citizensnpcs.co/repo</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.spigotmc</groupId>
                <artifactId>spigot-api</artifactId>
                <version>${org.spigotmc.spigot-api.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>io.papermc.paper</groupId>
                <artifactId>paper-api</artifactId>
                <version>${io.papermc.paper.paper-api.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>de.bluecolored</groupId>
                <artifactId>bluemap-api</artifactId>
                <version>${de.bluecolored.bluemap-api.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>net.citizensnpcs</groupId>
                <artifactId>citizens-main</artifactId>
                <version>${net.citizensnpcs.citizens-main.version}</version>
                <type>jar</type>
                <scope>provided</scope>
                <exclusions>
                    <exclusion>
                        <groupId>*</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>bluemap-entities-api</module>
        <module>bluemap-entities-plugin</module>
        <module>bluemap-citizens-plugin</module>
        <module>bluemap-vehicles-api</module>
        <module>bluemap-vehicles-plugin</module>
        <module>bluemap-mobs-api</module>
        <module>bluemap-mobs-plugin-common</module>
        <module>bluemap-mobs-spigot</module>
        <module>bluemap-mobs-paper</module>
        <module>bluemap-others-api</module>
        <module>bluemap-others-plugin-common</module>
        <module>bluemap-others-spigot</module>
        <module>bluemap-others-paper</module>
        <module>textures-maven-plugin</module>
    </modules>
</project>
